# Copy this file to .env and fill in the values.
DATABASE_URI=mongodb://localhost:27017/blooddb
PORT=5000
JWT_SECRET=your_jwt_secret_here
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# "development" → cookies use lax/non-secure, CORS allows all RFC-1918 addresses.
# "production"  → cookies use none/secure, CORS locked to the deployment domains
#                 listed in server.js (bloodline.gces.net.in and the older two).
# Render sets this to "production" via its own dashboard; never commit production here.
NODE_ENV=development

# Bind address. 0.0.0.0 = all interfaces (LAN + localhost). Render ignores this.
HOST=0.0.0.0

# Optional: extra comma-separated origins to allow beyond the built-in RFC-1918 list.
# Example: ALLOWED_ORIGINS=http://172.16.137.161:5173
ALLOWED_ORIGINS=
