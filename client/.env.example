# Copy this file to .env.local for local overrides (Vite ignores .env.local in production builds).
#
# VITE_API_URL is optional. When absent the frontend uses the same hostname as the
# browser (window.location.hostname) with port 5000, which means:
#
#   Your laptop  : http://localhost:5173  → backend at http://localhost:5000   ✓
#   Friend's lap : http://172.16.137.161:5173 → backend at http://172.16.137.161:5000 ✓
#
# Set this only if your backend runs on a different host or port:
# VITE_API_URL=http://172.16.137.161:5000
#
# VITE_SITE_URL is the public address used for links inside notification emails.
# It defaults to https://bloodline.gces.net.in and should NOT be set to a
# localhost or LAN address: an email is opened later, on someone else's phone,
# where such a link is dead. Set it only for a staging domain.
# VITE_SITE_URL=https://staging.bloodline.gces.net.in
